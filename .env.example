# LedgerLeaf AI — Environment Configuration
# Copy this file to .env and fill in real values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=LedgerLeaf AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://ledgerleaf:password@localhost:5432/ledgerleaf
# SQLite (local development fallback)
# DATABASE_URL=sqlite+aiosqlite:///./ledgerleaf.db

# =============================================================================
# SUPABASE AUTH
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# AI PROVIDER
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key
AI_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1
AI_MONTHLY_LIMIT_PER_ORG=1000

# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_BACKEND=local
# For S3-compatible storage:
# STORAGE_BACKEND=s3
# S3_BUCKET=ledgerleaf-uploads
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
LOCAL_STORAGE_PATH=./uploads

# =============================================================================
# REDIS (Background Jobs)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EMAIL
# =============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your-key
EMAIL_FROM=noreply@ledgerleaf.ai

# =============================================================================
# STRIPE (Billing)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# =============================================================================
# FRONTEND
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
